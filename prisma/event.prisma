model Event {
    id String @id @default(uuid())

    title       String
    description String      @db.Text
    type        EventType[]
    image       String?

    eventDate DateTime
    location  String

    minParticipants     Int @default(2)
    maxParticipants     Int
    currentParticipants Int @default(0)

    joiningFee Decimal @default(0) @db.Decimal(10, 2)

    status EventStatus @default(OPEN)

    hostId String
    host   User   @relation("HostedEvents", fields: [hostId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // soft delete: hidden from every list; a delete keeps the row + bookings
    deletedAt DateTime?

    bookings Booking[]
    reviews  Review[]

    @@index([hostId])
    @@index([eventDate])
    @@index([status])
    @@index([status, eventDate])
    @@index([deletedAt])
    @@map("events")
}

model Booking {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    eventId String
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    status      BookingStatus @default(PENDING)
    // numberOfTickets Int           @default(1)
    totalAmount Decimal       @db.Decimal(10, 2)
    payments    Payment[]

    bookedAt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, eventId])
    @@index([userId])
    @@index([eventId])
    @@index([status])
    @@map("bookings")
}
